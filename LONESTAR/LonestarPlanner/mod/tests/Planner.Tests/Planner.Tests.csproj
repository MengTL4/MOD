<Project Sdk="Microsoft.NET.Sdk">

  <!--
    测试用普通控制台程序，不引入 xunit 等外部依赖：
    dotnet run 就能跑，任何环境都不需要联网 restore。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>LonestarPlanner.Tests</RootNamespace>
    <AssemblyName>LonestarPlanner.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Planner.Core\Planner.Core.csproj" />
  </ItemGroup>

</Project>
