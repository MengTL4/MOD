<Project Sdk="Microsoft.NET.Sdk">

  <!-- Battle solver: in-process snapshot search over a pool of worker processes, plus the TCP
       service the in-game planner mod talks to. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Harmony hooks must not be bypassed by JIT inlining of the patched game methods. -->
    <TieredPGO>false</TieredPGO>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lonestar.Engine\Lonestar.Engine.csproj" />
  </ItemGroup>

</Project>
