<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The planner mod's own client code (BrainClient / BrainService, compiled from the mod's sources)
    against a real Brain service, with the game's LitJson. Unity types the mod touches are stubbed
    in Stubs.cs (plain .NET cannot call into UnityEngine).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GameManaged>F:\SteamLibrary\steamapps\common\LONESTAR\LONESTAR_Data\Managed</GameManaged>
    <PlannerMod>$(MSBuildThisFileDirectory)..\..\..\mod\src\Planner.Mod</PlannerMod>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(PlannerMod)\BrainClient.cs" Link="Mod\BrainClient.cs" />
    <Compile Include="$(PlannerMod)\BrainService.cs" Link="Mod\BrainService.cs" />
    <Reference Include="Assembly-CSharp-firstpass" HintPath="$(GameManaged)\Assembly-CSharp-firstpass.dll" />
  </ItemGroup>
</Project>
